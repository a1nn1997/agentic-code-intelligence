# ACP configuration — copy to `.env` and edit. Every var is prefixed ACP_.
# The DEFAULTS here boot the entire stack keyless in stub mode (`make up`).
# You only need a key to run against real Claude (`make up-claude`).

# --- service / gateway ---
ACP_ENV=local
ACP_LOG_LEVEL=INFO
ACP_GATEWAY_HOST=0.0.0.0
ACP_GATEWAY_PORT=8000

# --- state (SQLite, WAL mode) ---
ACP_DATABASE_URL=sqlite:///./var/acp.db

# --- model brain ---
# stub = deterministic, keyless (default). claude = real Anthropic API (needs key).
ACP_MODEL_BACKEND=stub
# Leave EMPTY for stub mode. Set ONLY for claude backend. Lives only in the gateway env.
ACP_MODEL_API_KEY=
ACP_MODEL_NAME=claude-sonnet-4-6

# --- sandbox tier ---
# python (Phase 3 reference) | go | rust | ts (Phase 8 parity runners)
ACP_SANDBOX_RUNNER=python
ACP_SANDBOX_HOST=http://sandbox:9000
# Docker image the Python reference runner executes untrusted work in.
ACP_SANDBOX_IMAGE=acp-sandbox:latest
# Resource ceilings enforced on every sandbox run (each maps to a docker flag).
ACP_SANDBOX_CPUS=1.0
ACP_SANDBOX_MEMORY_MB=512
ACP_SANDBOX_TMPFS_MB=256
ACP_SANDBOX_WALL_CLOCK_SECONDS=60
ACP_SANDBOX_PIDS=256

# --- budget defaults (server-side enforced; per-task overridable) ---
ACP_DEFAULT_TASK_TOKEN_BUDGET=200000
ACP_DEFAULT_TASK_STEP_BUDGET=40
ACP_DEFAULT_TASK_WALL_CLOCK_SECONDS=900
ACP_DEFAULT_USER_DAILY_TOKEN_BUDGET=2000000

# --- $/task metering constants (cost reasoning, not billing) ---
ACP_PRICE_PER_1K_INPUT_TOKENS_USD=0.003
ACP_PRICE_PER_1K_OUTPUT_TOKENS_USD=0.015
